; Proyecto de Godot 4.4 con los escenarios 3D de Venezuela (exportados desde Blender).
; Ver docs/06_godot.md.

config_version=5

[application]

config/name="Escenarios 3D Venezuela"
config/description="Altamira y La Carlota (Caracas) exportados desde el pipeline OSM/DEM -> Blender"
run/main_scene="res://escenas/principal.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/vsync/vsync_mode=1

[physics]

common/physics_ticks_per_second=60

[rendering]

textures/canvas_textures/default_texture_filter=1
textures/default_filters/anisotropic_filtering_level=3
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
anti_aliasing/quality/screen_space_aa=1
mesh_lod/lod_change/threshold_pixels=1.0
occlusion_culling/use_occlusion_culling=false
environment/defaults/default_clear_color=Color(0.6, 0.7, 0.8, 1)
